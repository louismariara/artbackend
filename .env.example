# Copy this file to ".env" and fill in real values. Never commit ".env".

# "development" allows weak keys and the sandbox commands.
# Anything else (including leaving this out) is treated as production.
APP_ENV=development

# Required in production: random strings of at least 32 characters.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Database. Leave DB_HOST empty to use the local SQLite file (development only).
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Web addresses. Production example, if your domain is yoursite.com:
#   CORS_ORIGINS=https://yoursite.com,https://www.yoursite.com
#   CORS_SUBDOMAIN_BASES=yoursite.com
#   FRONTEND_URL=https://yoursite.com
#   FRONTEND_URL_TEMPLATE=https://{slug}.yoursite.com
#   BASE_DOMAIN=yoursite.com
CORS_ORIGINS=http://localhost:5173
CORS_SUBDOMAIN_BASES=localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_TEMPLATE=
BASE_DOMAIN=

# How many galleries one network address may create
GALLERY_CREATE_LIMIT=5 per hour

PORT=5000